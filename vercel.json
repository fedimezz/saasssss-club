{
  "crons": [
    { "path": "/api/cron/trial-check",          "schedule": "0 6 * * *" },
    { "path": "/api/cron/subscription-renewal", "schedule": "0 6 * * *" },
    { "path": "/api/cron/session-reminders",    "schedule": "0 7 * * *" }
  ],
  "rewrites": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "(?<slug>[^.]+)\\.(?<rest>.+)" }],
      "destination": "/:path*"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
