# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DB_NAME"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET="your-jwt-secret-minimum-32-characters"

# ─── App URLs ────────────────────────────────────────────────────────────────
# Production: your root domain (apex). Subdomains will be gym.APP_DOMAIN
APP_URL="https://yoursaas.com"
NEXT_PUBLIC_APP_URL="https://yoursaas.com"

# ─── Upstash Redis (rate limiting + SSE pub/sub) ──────────────────────────
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ─── Cloudinary (profile pictures, gym logos) ────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Google OAuth ────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="https://yoursaas.com/api/auth/callback/google"

# ─── Konnect (payment gateway) ───────────────────────────────────────────
KONNECT_API_KEY="your-konnect-api-key"
KONNECT_BASE_URL="https://api.konnect.network"
KONNECT_WALLET_ID="your-wallet-id"

# ─── Email (SMTP) ────────────────────────────────────────────────────────
SMTP_URL="smtp://user:password@smtp.example.com:587"
SMTP_FROM="noreply@yoursaas.com"

# ─── SMS (Twilio) ────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_FROM_NUMBER="+1234567890"

# ─── Cron (protect cron endpoints) ───────────────────────────────────────
CRON_SECRET="your-cron-secret"

# ─── Dev only (tenant resolution without subdomain) ──────────────────────
# DEV_DEFAULT_CLUB_SLUG="demo-gym"
