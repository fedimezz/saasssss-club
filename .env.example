# ─── Database ────────────────────────────────────────────────────────────────
# Primary connection (used by Prisma at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# Direct connection for Prisma migrations (bypass PgBouncer if used)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ─── App ─────────────────────────────────────────────────────────────────────
# Base URL of the SaaS platform (no trailing slash)
APP_URL="https://yoursaas.com"
NEXT_PUBLIC_APP_URL="https://yoursaas.com"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Must be at least 32 characters (enforced in production) — generate with: openssl rand -base64 48
JWT_SECRET="change-me-minimum-32-chars-xxxxxxxxxxxxxxxx"

# ─── Redis (Upstash) — rate limiting + realtime notifications (SSE) ──────────
# Optional in local dev (falls back to per-process in-memory rate limiting).
# REQUIRED in production so limits work across serverless instances.
UPSTASH_REDIS_REST_URL="https://YOUR_INSTANCE.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_TOKEN"

# ─── Cloudinary — image uploads ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
# The subdomain → apex handoff is handled via a signed `state` param + a
# platform-wide cookie (see app/api/auth/google/route.ts). Just needs the
# callback URL below registered exactly in Google Cloud Console.
GOOGLE_REDIRECT_URI="https://yoursaas.com/api/auth/callback/google"

# ─── Konnect — payment gateway ───────────────────────────────────────────────
KONNECT_API_KEY="your-konnect-api-key"
KONNECT_BASE_URL="https://api.konnect.network/api/v2"
KONNECT_WALLET_ID="your-wallet-id"

# ─── Email (Brevo transactional API) ─────────────────────────────────────────
# Emails are sent through Brevo's REST API (lib/email.ts) — NOT SMTP.
# Get a key at https://app.brevo.com → SMTP & API → API keys.
# In development, if this is empty, emails are printed to the server console
# instead of being sent (handy for copying verification links).
# In PRODUCTION an empty key means verification / reset / reminder emails are
# silently NOT delivered — set it.
BREVO_API_KEY=""
# Sender shown on outgoing emails — must be a verified sender/domain in Brevo.
SMTP_FROM="no-reply@yoursaas.com"

# ─── SMS (Twilio) ────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_FROM_NUMBER="+33600000000"

# ─── Cron jobs ───────────────────────────────────────────────────────────────
# Secret sent as Authorization: Bearer <CRON_SECRET> header by Vercel Crons.
# Min 16 chars; if unset/short, every /api/cron/* call is rejected (fail-closed).
# Generate with: openssl rand -hex 32
CRON_SECRET="change-me-cron-secret-xxxxxxxxxxxxxxxx"

# ─── Error monitoring (Sentry) — NOT wired up yet ────────────────────────────
# sentry.*.config.ts are empty stubs and @sentry/nextjs is not installed.
# To enable: npm install @sentry/nextjs && npx @sentry/wizard@latest -i nextjs
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# ─── Auth cookie scope (optional) ────────────────────────────────────────────
# Leave empty: the cookie is scoped to the exact host the user logged in on
# (safest for multi-tenant — a session on gym1.yoursaas.com is not sent to
# gym2.yoursaas.com). Only set if you deliberately want one cookie shared
# across subdomains, e.g. ".yoursaas.com".
COOKIE_DOMAIN=""

# ─── Platform bootstrap (production seed only) ───────────────────────────────
# `NODE_ENV=production npx prisma db seed` seeds ONLY the SaaS plan catalog,
# plus the platform SUPER_ADMIN if both of these are set (password 12+ chars).
# It never creates the demo clubs / demo accounts in production.
SUPER_ADMIN_EMAIL=""
SUPER_ADMIN_PASSWORD=""

# ─── Dev only ────────────────────────────────────────────────────────────────
# Local tenant routing needs NO env var: club-a.localhost:3000 is gym "club-a",
# club-b.localhost:3000 is gym "club-b", plain localhost:3000 is the platform
# (landing page + super-admin login). Chrome/Firefox/Edge resolve *.localhost
# automatically; Safari needs /etc/hosts entries.
#
# Only set this if you want plain localhost:3000 to act as one specific gym.
# WARNING: while it is set, the SUPER_ADMIN login cannot work on plain localhost.
# DEV_DEFAULT_CLUB_SLUG="club-a"

# Set to 1 to force JSON log output in development
JSON_LOGS=0
# Set to 1 to enable debug log output in production
DEBUG=0
