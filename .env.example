# ─── Database ────────────────────────────────────────────────────────────────
# Primary connection (used by Prisma at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# Direct connection for Prisma migrations (bypass PgBouncer if used)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# ─── App ─────────────────────────────────────────────────────────────────────
# Base URL of the SaaS platform (no trailing slash)
APP_URL="https://yoursaas.com"
NEXT_PUBLIC_APP_URL="https://yoursaas.com"

# ─── Auth ────────────────────────────────────────────────────────────────────
# Must be at least 32 characters — generate with: openssl rand -base64 32
JWT_SECRET="change-me-minimum-32-chars-xxxxxxxxxxxxxxxx"

# ─── Redis (Upstash) — rate limiting ─────────────────────────────────────────
UPSTASH_REDIS_REST_URL="https://YOUR_INSTANCE.upstash.io"
UPSTASH_REDIS_REST_TOKEN="YOUR_TOKEN"

# ─── Cloudinary — image uploads ──────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ─── Google OAuth (optional) ─────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-client-secret"
GOOGLE_REDIRECT_URI="https://yoursaas.com/api/auth/google/callback"

# ─── Konnect — payment gateway ───────────────────────────────────────────────
KONNECT_API_KEY="your-konnect-api-key"
KONNECT_BASE_URL="https://api.konnect.network"
KONNECT_WALLET_ID="your-wallet-id"

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
# SMTP connection string — e.g. smtps://user:pass@smtp.example.com:465
SMTP_URL="smtps://user:password@smtp.example.com:465"
SMTP_FROM="no-reply@yoursaas.com"

# ─── SMS (Twilio) ────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_FROM_NUMBER="+33600000000"

# ─── Cron jobs ───────────────────────────────────────────────────────────────
# Secret sent as Authorization: Bearer <CRON_SECRET> header by Vercel Crons
CRON_SECRET="change-me-cron-secret-xxxxxxxxxxxxxxxx"

# ─── Error monitoring (Sentry) ───────────────────────────────────────────────
# Install: npm install @sentry/nextjs
# Then run: npx @sentry/wizard@latest -i nextjs
SENTRY_DSN="https://xxx@oyyy.ingest.sentry.io/zzz"
NEXT_PUBLIC_SENTRY_DSN="https://xxx@oyyy.ingest.sentry.io/zzz"
SENTRY_ORG="your-org-slug"
SENTRY_PROJECT="your-project-slug"
# Optional: upload source maps (get from sentry.io → Settings → Auth Tokens)
SENTRY_AUTH_TOKEN="sntrys_xxxx"

# ─── Dev only ────────────────────────────────────────────────────────────────
# Default club slug when running locally without a wildcard subdomain
DEV_DEFAULT_CLUB_SLUG="demo"
# Set to 1 to force JSON log output in development
JSON_LOGS=0
# Set to 1 to enable debug log output in production
DEBUG=0
